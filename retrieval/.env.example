# Copy to retrieval/.env. Read by both ingest.py and server.py (real env vars win).

# Embedding model. bge-m3 is multilingual (Bangla + English, cross-language search).
# After changing it, run: python ingest.py --force
EMBED_MODEL=BAAI/bge-m3

# cuda / cpu. Default: cuda when available.
# EMBED_DEVICE=cuda

# Max tokens per chunk fed to the model (keeps a 4 GB GPU safe).
# EMBED_MAX_TOKENS=1024

# Where the .jsonl files and the Chroma database live.
# DATA_DIR=../backend/data
# CHROMA_DIR=./chroma_db

# Query-side instruction. Auto-set for English bge models; leave empty for bge-m3.
# QUERY_PREFIX=
