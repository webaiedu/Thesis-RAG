# Copy to .env. Never commit .env.

# ---------------- Gemini (Google AI Studio) ----------------
# Used for general questions and (by default) for the router.
GEMINI_API_KEY=
# "-latest" aliases always point at Google's newest model of that size ("auto").
# gemini = Gemini (uses GENERAL_MODEL), lmstudio = local LMSTUDIO_CHAT_MODEL
GENERAL_PROVIDER=gemini
GENERAL_MODEL=gemini-flash-latest

# ---------------- Router: legal question? which law? ----------------
# gemini = fast and accurate (recommended). lmstudio = fully local but slower.
ROUTER_PROVIDER=gemini
ROUTER_MODEL=gemini-flash-lite-latest

# ---------------- Who writes the LEGAL answers ----------------
# lmstudio = your local Gemma, gemini = Gemini (uses GEMINI_MODEL below)
LLM_PROVIDER=lmstudio
GEMINI_MODEL=gemini-flash-latest
LMSTUDIO_URL=http://localhost:1234/v1
# Exact id: open http://localhost:1234/v1/models in your browser
LMSTUDIO_CHAT_MODEL=gemma-4-e4b-it

# ---------------- Answer models (picked under the chat box) ----------------
# Exact LM Studio ids (http://localhost:1234/v1/models). Used when LLM_PROVIDER /
# GENERAL_PROVIDER = lmstudio. LMSTUDIO_CHAT_MODEL above is then only the router's default.
LMSTUDIO_MODEL_HIGH=qwen/qwen3-next-80b-a3b-instruct
LMSTUDIO_MODEL_MID=qwen/qwen3-30b-a3b-2507
LMSTUDIO_MODEL_LOW=google/gemma-4-e4b
# Router model when ROUTER_PROVIDER=lmstudio. Empty = LMSTUDIO_CHAT_MODEL.
ROUTER_LMSTUDIO_MODEL=
# Local vision model that reads uploaded images (with OCR). Empty = OCR only.
VISION_MODEL=google/gemma-4-e4b

# ---------------- Law search (Python service) ----------------
RETRIEVAL_URL=http://localhost:8000
TOP_K=5
# Ignore weak matches below this cosine score (0 = off). Tune after testing.
MIN_SCORE=0
# Catch-all database (backend/data/<id>.jsonl) searched in Auto mode when the routed
# database has no hit scoring >= FALLBACK_MIN_SCORE, or when no specific database fits.
# The router never picks it directly. Empty = off. Re-measure the score with
# retrieval/calibrate.py after changing EMBED_MODEL or adding data.
FALLBACK_DOMAIN=uncategorized
FALLBACK_MIN_SCORE=0.56

# ---------------- Usage limit ----------------
# Tokens each user may use per hour (prompt + answer, every model call incl. routing and
# image reading). The hour starts with the user's first request; ~20-30 typical questions.
TOKEN_LIMIT_PER_HOUR=200000

# ---------------- Firebase ----------------
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

FRONTEND_URL=http://localhost:3000
PORT=4000
